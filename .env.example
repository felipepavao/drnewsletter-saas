# =============================================================
# Dr. Newsletter SaaS — .env.example
# =============================================================
# Copie este arquivo para `.env` e preencha com valores reais.
# O `.env` NUNCA deve ser commitado. Está no .gitignore.
# Em produção, manter `.env` com chmod 600 e dono www-data.
# =============================================================

# --- App ---
APP_NAME="Dr. Newsletter"
APP_ENV=local
APP_URL=http://localhost:8080
APP_SECRET=change_me_to_a_long_random_string_min_32_chars

# --- Segurança / Proxy ---
TRUST_PROXY=false
COOKIE_SECURE=false

# --- Anthropic / Claude ---
# ATENÇÃO: chave usada APENAS server-side. Nunca exposta ao browser.
# Configure spending cap no console.anthropic.com antes de usar em produção.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=1.0

# Limites operacionais (defesa em profundidade)
CLAUDE_DAILY_USD_CAP=10
CLAUDE_REQUEST_TIMEOUT=120

# --- Email (magic link) ---
# Em DEV: deixe BREVO_API_KEY e SMTP_HOST vazios. O código aparece em
#         data/logs/mail.log para você testar sem enviar email de verdade.
# Em PROD: preencha UMA das opções abaixo.
#
# Opção 1 (recomendada): API HTTP do Brevo
BREVO_API_KEY=
# Opção 2: SMTP genérico (fallback se BREVO_API_KEY estiver vazio)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
FROM_EMAIL=nao-responda@drnewsletter.local
FROM_NAME="Dr. Newsletter"

# --- Admin seed ---
ADMIN_EMAIL=
