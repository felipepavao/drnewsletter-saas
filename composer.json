{
  "name": "felipepavao/drnewsletter-saas",
  "description": "Dr. Newsletter SaaS — plataforma de planejamento e escrita de newsletters para negócios presenciais premium. PHP vanilla + SQLite.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "pestphp/pest": "^2.0"
  },
  "autoload-dev": {
    "files": [
      "tests/Helpers.php"
    ]
  },
  "scripts": {
    "test": "pest",
    "migrate": "php bin/migrate.php",
    "serve": "php -S localhost:8080 -t public public/router.php"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
